{
  "name": "jianzhang-stock-desktop",
  "version": "6.0.1",
  "description": "见涨 - Windows 11 实时股票自选桌面应用",
  "main": "out/main/index.js",
  "author": "陈星",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ai-t": "set JIANZHANG_AI_T_ADVICE_MODULE=1&& electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint electron src electron.vite.config.ts vitest.config.ts",
    "format:check": "prettier --check \"electron/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"*.{ts,js,cjs,json}\"",
    "build": "tsc --noEmit && electron-vite build",
    "build:ai-t": "set JIANZHANG_AI_T_ADVICE_MODULE=1&& tsc --noEmit && electron-vite build",
    "build:unpacked": "npm run build && npm run generate:icon && electron-builder --config electron-builder.config.cjs --win --dir",
    "generate:icon": "node scripts/generate-icon.mjs",
    "package:win": "npm run build && npm run generate:icon && electron-builder --config electron-builder.config.cjs --win nsis",
    "package:portable": "npm run build && npm run generate:icon && electron-builder --config electron-builder.config.cjs --win portable"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.525.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@openai/codex": "0.144.6",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
